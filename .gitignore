# Secrets and local environment
.env
.env.*
!.env.example
**/.env
**/.env.*

# Python and editor artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.idea/
.vscode/

# Runtime logs and task state
**/logs/
*.log
**/batch_tasks.json
**/summary.json
**/summary.csv

# MinerU generated bundles duplicate the source PDF and can be very large.
**/paper/mineru/
**/paper/*__mineru.md
!**/parsed/paper/*__mineru.md
**/paper/*__mineru.zip

# Parsed MinerU task bundles duplicate source PDFs, images, and model JSON.
# Keep the stable Markdown sidecars and extraction JSONs under parsed/ tracked,
# but keep these reproducible intermediate bundles local.
**/parsed/paper/mineru/
**/parsed/supplement/mineru/

# Copyrighted / bulky source material: keep provenance in README and manifest.
**/paper/*.pdf
**/supplement/*.pdf
**/supplement/*.docx
**/supplement/*.xlsx
**/supplement/*.xml
**/supplement/*.zip
**/supplement/*.mp4
**/references/**/*.zip
**/references/**/*.docx
**/references/**/*.xlsx
**/references/**/*.xml
**/references/**/*.mp4

# Large tabular supplementary products and extracted phase directories
data/**/*.xlsx
data/**/phases/
data/**/context/

# Raw archives and machine-scale phase-arrival products stay local.
**/catalogs/**/raw/
**/catalogs/**/*.zip
**/catalogs/**/*.tar
**/catalogs/**/*.tar.gz
**/catalogs/**/*.h5
**/catalogs/**/*.hdf5

# Large source catalogs; small canonical tables can be force-added explicitly.
data/**/*.csv
data/**/*.txt
data/**/*.xml

# Temporary downloads and OS metadata
**/.DS_Store
**/__MACOSX/
*.part
*.tmp

# Local large run outputs are exposed through a machine-specific project link.
/runs

# Continuous waveforms remain local after the source-layout migration.
data/**/waveforms

# Native velocity-model downloads and third-party implementation evidence stay local.
data/**/data/models/raw/

# Large or reproducible data products under the canonical data tree.
data/**/analysis/figures/
data/**/analysis/stats/
data/**/analysis/derived/
data/**/catalogs/**/raw/

# Locally regenerated Kilauea analysis metadata is intentionally excluded.
data/2018_kilauea_hawaii/data/catalogs/MATOZA2021_EA001253/analysis/stats/relocated_events/full_v1.json

# Small, reviewed Ridgecrest diagnostic tables accompany their figures.
!data/2019_ridgecrest_california/analysis/figures/waveform_quality/*.csv
!data/2019_ridgecrest_california/analysis/figures/instrument_response/response_audit.csv
!data/2019_ridgecrest_california/analysis/figures/waveform_examples/mw*_record_section.csv
# Reproducible processed waveform excerpts stay local.
data/2019_ridgecrest_california/analysis/figures/instrument_response/response_examples.npz

# Bulk supplementary tables extracted into Markdown stay local.
/data/2016_kaikoura_new_zealand/references/TAN2024_JB028735/parsed/supplement/2024jb028735-sup-0003-table si-s10__extracted.md
/data/2016_kaikoura_new_zealand/references/TAN2024_JB028735/parsed/supplement/2024jb028735-sup-0004-table si-s11__extracted.md

# Host-specific proxy/bootstrap script from external evaluation notes.
docs/reference/codex-eval-tutorial/scripts/setup_proxy_env.sh
