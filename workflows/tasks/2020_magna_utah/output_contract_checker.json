{
  "schema_version": 1,
  "artifacts": [
    {
      "id": "picks",
      "path": "picks.csv",
      "kind": "picks",
      "required": true,
      "schema": {
        "name": "csv-columns",
        "version": 1,
        "required_columns": [
          "pick_id",
          "event_id",
          "station_id",
          "channel_id",
          "phase",
          "time_utc",
          "probability",
          "uncertainty_s",
          "method",
          "status"
        ]
      }
    },
    {
      "id": "catalog",
      "path": "catalog.csv",
      "kind": "csv",
      "required": true,
      "schema": {
        "name": "csv-columns",
        "version": 1,
        "required_columns": [
          "event_id",
          "origin_time_utc",
          "latitude",
          "longitude",
          "depth_km",
          "magnitude",
          "magnitude_type",
          "n_picks",
          "n_p_picks",
          "n_s_picks",
          "status"
        ]
      }
    },
    {
      "id": "checker_report",
      "path": "checker/final/checker_report.json",
      "kind": "checker_report",
      "required": true,
      "schema": {
        "name": "seismotools-checker-report",
        "version": 1
      },
      "description": "seismotools/checker/interface/run.py on the submitted catalog.csv and picks.csv (stage all, or the latest stage produced)"
    },
    {
      "id": "checker_dispositions",
      "path": "checker/dispositions.json",
      "kind": "checker_dispositions",
      "required": true,
      "schema": {
        "name": "checker-dispositions",
        "version": 1,
        "entry": {
          "flag_id": "as in the report's flags",
          "disposition": "fixed | justified",
          "what_changed": "for fixed",
          "report_before": "for fixed: the report in which the flag was raised",
          "evidence": "for justified: measurements, files or an experiment"
        }
      },
      "description": "one entry per flag of checker_report"
    }
  ]
}
