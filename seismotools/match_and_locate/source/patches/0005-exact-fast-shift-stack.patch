 //calculate the threshold of detection
+// SeismoAgentBench patch 0005: k-th smallest value by in-place quickselect.
+// On return a[0..k-1] <= a[k] <= a[k+1..n-1].
+static float select_kth(float *a, int n, int k) {
+    int lo = 0, hi = n - 1, i, j;
+    float pivot, t;
+    while(hi > lo) {
+        pivot = a[lo + (hi - lo)/2];
+        i = lo; j = hi;
+        while(i <= j) {
+            while(a[i] < pivot) i++;
+            while(a[j] > pivot) j--;
+            if(i <= j) { t = a[i]; a[i] = a[j]; a[j] = t; i++; j--; }
+        }
+        if(k <= j) hi = j;
+        else if(k >= i) lo = i;
+        else break;
+    }
+    return a[k];
+}
+
+// Median of a[0..n-1] (a is reordered), with the original even-n arithmetic.
+static float median_select(float *a, int n) {
+    float hi, lo;
+    int i;
+    if(n%2 == 1) return select_kth(a, n, (n-1)/2);
+    hi = select_kth(a, n, n/2);
+    lo = a[0];
+    for(i=1; i<n/2; i++) if(a[i] > lo) lo = a[i];
+    return (hi+lo)/2;
+}
