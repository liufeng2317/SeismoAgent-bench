{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seismoagentbench.org/schemas/input.schema.json",
  "title": "SeismoAgentBench input configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "description": {"type": "string"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "type"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "path": {"type": "string", "pattern": "^/[^\\u0000]*$"},
          "type": {"enum": ["file", "folder"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
