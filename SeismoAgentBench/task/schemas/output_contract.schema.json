{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seismoagentbench.org/schemas/output-contract.schema.json",
  "title": "SeismoAgentBench output contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "kind", "required"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"},
          "kind": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"}
        }
      }
    }
  }
}
